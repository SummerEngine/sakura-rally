; Sakura Rally — a cel-shaded low-poly rally through Japanese mountains.
; Engine settings, file format version.
config_version=5

[application]

config/name="Sakura Rally"
config/description="Cel-shaded low-poly rally through Japanese mountains in spring and autumn."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="car"
3d_physics/layer_3="props"
3d_physics/layer_4="triggers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.62, 0.78, 0.93, 1)

[shader_globals]

sr_shade_tint={
"type": "color",
"value": Color(0.604, 0.573, 0.784, 1)
}
sr_rim_color={
"type": "color",
"value": Color(1, 0.94, 0.86, 1)
}
sr_wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 1, 0.37)
}
sr_glow={
"type": "float",
"value": 0.0
}
sr_grain={
"type": "sampler2D",
"value": "res://assets/textures/grain.png"
}
